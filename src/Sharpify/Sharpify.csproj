<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>preview</LangVersion>
        <Version>3.0.0</Version>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Authors>David Shnayder</Authors>
        <Copyright>David Shnayder</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>CHANGELOGLATEST.md</PackageReadmeFile>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <Title>Sharpify</Title>
        <Description>A collection of high performance language extensions for C#</Description>
        <PackageProjectUrl>https://github.com/dusrdev/Sharpify</PackageProjectUrl>
        <RepositoryUrl>https://github.com/dusrdev/Sharpify</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>Extensions;HighPerformance;DiscriminatedUnion;Result</PackageTags>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <SynchReleaseVersion>false</SynchReleaseVersion>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="CHANGELOG.md" Pack="true" PackagePath="\" />
        <None Include="CHANGELOGLATEST.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
